# URL de conexão com o Postgres usada pela aplicação (pode ser "pooled", ex: Neon).
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# URL de conexão direta (não-pooled) usada apenas para rodar migrations.
# Em provedores como a Neon, use a mesma URL do DATABASE_URL trocando o host
# "-pooler" pelo host direto. Se seu provedor não tiver pooler, repita o
# mesmo valor do DATABASE_URL aqui.
DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Senha única, compartilhada entre Renato e Nicole, para entrar na agenda.
SHARED_PASSWORD="escolha-uma-senha-forte"

# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório,
# por exemplo com: openssl rand -base64 32
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"
